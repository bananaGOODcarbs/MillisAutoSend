<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="毫秒定时发送 · Shizuku版"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="到点后通过 Shizuku 注入一次系统 Enter 键，不读取微信控件，也不使用坐标。"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/shizukuStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Shizuku：未连接"
            android:textIsSelectable="true"
            android:textStyle="bold" />

        <Button
            android:id="@+id/openShizukuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. 打开 / 安装 Shizuku" />

        <Button
            android:id="@+id/shizukuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. 授权并连接 Shizuku" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="目标时间（时:分:秒.毫秒）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/timeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789:."
            android:hint="14:00:00.350"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="提前发送（毫秒）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/leadInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="100"
            android:inputType="numberSigned"
            android:maxLines="1"
            android:text="100" />

        <TextView
            android:id="@+id/currentTimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="当前时间：--:--:--.---"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="86dp"
            android:text="状态：未启动"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3. 5秒后测试 Enter" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. 开始定时" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="停止任务" />

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开电池优化设置" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="使用前必须确认：\n1. Shizuku 正在运行且本应用已获授权；\n2. 微信已开启“回车键发送消息”，否则 Enter 可能只会换行；\n3. 提前输入文字，保持微信聊天输入框聚焦；\n4. 屏幕保持点亮并解锁；\n5. 每次手机重启后需要重新启动 Shizuku。"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
